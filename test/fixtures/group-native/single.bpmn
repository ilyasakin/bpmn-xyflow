<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:qa="urn:bpmn-xyflow:group-label-qa" id="GroupDefinitions" targetNamespace="urn:bpmn-xyflow:group-label-qa">
  <bpmn:category id="ReviewCategory" name="Review classifications" qa:trace="category-metadata"><bpmn:documentation>Retain category documentation.</bpmn:documentation><bpmn:categoryValue id="ReviewValue" value="Shared review group" qa:trace="value-metadata"><bpmn:documentation>Retain category-value documentation.</bpmn:documentation></bpmn:categoryValue></bpmn:category>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:task id="Task"><bpmn:ioSpecification id="TaskIO"><bpmn:dataInput id="TaskInput"/><bpmn:dataOutput id="TaskOutput"/><bpmn:inputSet id="TaskInputs"><bpmn:dataInputRefs>TaskInput</bpmn:dataInputRefs></bpmn:inputSet><bpmn:outputSet id="TaskOutputs"><bpmn:dataOutputRefs>TaskOutput</bpmn:dataOutputRefs></bpmn:outputSet></bpmn:ioSpecification><bpmn:dataInputAssociation id="DataIn"><bpmn:sourceRef>InputReference</bpmn:sourceRef><bpmn:targetRef>TaskInput</bpmn:targetRef></bpmn:dataInputAssociation><bpmn:dataOutputAssociation id="DataOut"><bpmn:sourceRef>TaskOutput</bpmn:sourceRef><bpmn:targetRef>OutputReference</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:task>
    <bpmn:dataObject id="InputData"/><bpmn:dataObject id="OutputData"/><bpmn:dataObjectReference id="InputReference" dataObjectRef="InputData"/><bpmn:dataObjectReference id="OutputReference" dataObjectRef="OutputData"/>
    <bpmn:group id="GroupA" categoryValueRef="ReviewValue" qa:trace="group-a"><bpmn:documentation>Imported shared group.</bpmn:documentation></bpmn:group>
    <bpmn:textAnnotation id="Note"><bpmn:text>Associations have no editable label.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association" sourceRef="Task" targetRef="Note"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram"><bpmndi:BPMNPlane id="Plane" bpmnElement="Process_1">
    <bpmndi:BPMNShape id="GroupA_di" bpmnElement="GroupA" qa:trace="shape-metadata"><dc:Bounds x="250" y="180" width="300" height="200"/><bpmndi:BPMNLabel id="GroupLabelDI" qa:trace="label-metadata"><dc:Bounds x="285.25" y="184.5" width="229.5" height="20"><!-- group label bounds metadata --><?group-label keep?></dc:Bounds></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    
    <bpmndi:BPMNShape id="Task_di" bpmnElement="Task"><dc:Bounds x="350" y="550" width="100" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="InputReference_di" bpmnElement="InputReference"><dc:Bounds x="150" y="550" width="36" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="OutputReference_di" bpmnElement="OutputReference"><dc:Bounds x="700" y="720" width="36" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Note_di" bpmnElement="Note"><dc:Bounds x="750" y="550" width="180" height="60"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="Association_di" bpmnElement="Association"><di:waypoint x="450" y="590"/><di:waypoint x="650" y="590"/><di:waypoint x="750" y="580"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="DataIn_di" bpmnElement="DataIn"><di:waypoint x="186" y="575"/><di:waypoint x="350" y="590"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="DataOut_di" bpmnElement="DataOut"><di:waypoint x="400" y="630"/><di:waypoint x="400" y="745"/><di:waypoint x="700" y="745"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
